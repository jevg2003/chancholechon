---
import { WHATSAPP_URL } from '../lib/contact';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<section id="final" class="relative overflow-hidden bg-linear-to-br from-brand-800 via-brand-700 to-brand-900 text-cream-50">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<span class="cta-glow absolute left-1/2 top-1/2 size-112 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold-400/10 blur-3xl"></span>
	</div>

	<div class="cta-final-content relative mx-auto flex max-w-4xl flex-col items-center gap-6 px-4 py-24 text-center sm:py-32">
		<h2 data-reveal class="cta-title text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl">
			¿Listo para realizar <span class="text-gold-400">tu pedido?</span>
		</h2>
		<p data-reveal data-reveal-delay="80" class="cta-sub max-w-xl text-lg text-cream-50/80">
			Escríbenos por WhatsApp y te cotizamos de una — lechona, cojines, tamales y más.
		</p>

		<div class="mt-4 p-10" data-reveal data-reveal-delay="160">
			<a
				href={WHATSAPP_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-3 rounded-full bg-gold-500 px-10 py-5 text-xl font-extrabold text-brand-900 shadow-2xl transition-[background-color,translate] duration-200 hover:-translate-y-0.5 hover:bg-gold-600"
			>
				<span class="inline-flex items-center gap-3">
					<WhatsAppIcon class="size-7" />
					¡Realiza tu Pedido!
				</span>
			</a>
		</div>
	</div>
</section>
