---
import { Image } from 'astro:assets';
import type { Product } from '../types/product';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<button
	type="button"
	class="producto-card group relative aspect-[4/3] cursor-pointer overflow-hidden rounded-2xl bg-brand-800 shadow-lg outline-offset-4 transition-shadow hover:shadow-2xl"
	data-product={product.id}
	data-name={product.name}
	data-info={product.info}
	data-message={product.message}
	data-reference={product.referencePhoto ? 'true' : undefined}
	aria-haspopup="dialog"
	aria-label={`Ver ${product.name}`}
>
	<Image
		src={product.image}
		alt={product.imageAlt ?? `${product.name} de Lechonería Chancho el Lechón en Cali`}
		widths={[320, 480, 720, 960]}
		sizes="(min-width: 768px) 33vw, 50vw"
		format="webp"
		quality={78}
		loading="lazy"
		decoding="async"
		class="producto-img h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
	/>
	{
		product.referencePhoto && (
			<span class="pointer-events-none absolute left-2 top-2 rounded-full bg-brand-900/75 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-cream-50 backdrop-blur-sm">
				Foto de referencia
			</span>
		)
	}
	<span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-gradient-to-t from-brand-900/90 to-transparent px-3 pb-3 pt-10 sm:px-4">
		<span class="text-left text-sm font-extrabold leading-tight text-cream-50 sm:text-lg">{product.name}</span>
		<span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gold-500 text-lg font-black text-brand-900 transition-transform group-hover:rotate-90">+</span>
	</span>
</button>
