---
import { PHONE_E164 } from '../lib/contact';
import { products } from '../data/products';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import ProductCard from './ProductCard.astro';

const waNumber = PHONE_E164.replace('+', '');
---

<section id="nuestros-productos" class="py-16 sm:py-20 bg-cream-50">
	<div class="w-full px-4 sm:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="editorial-heading mb-2">¡Nuestras lechonas y productos!</h2>
			<p class="mb-10 text-lg font-semibold text-brand-600">
				Toca cada foto para conocer el producto y pedir tu cotización
			</p>
			<a href="#solicitar-pedido" class="mb-8 inline-flex min-h-12 items-center rounded-full bg-brand-800 px-6 py-3 font-bold text-cream-50">Completar solicitud de pedido</a>
		</div>

		<div class="productos-grid grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4">
			{products.map((product) => <ProductCard product={product} />)}
		</div>
	</div>
</section>

<!--
	Detalle de producto: <dialog> nativo (foco atrapado, Esc y fondo inerte
	gratis). La animación (src/lib/productModal.ts) hace crecer la foto desde
	su tarjeta hasta el centro y la devuelve al mismo sitio al cerrar.
-->
<dialog id="producto-modal" class="producto-dialog" aria-labelledby="producto-modal-title">
	<div class="pm-backdrop" data-pm-close></div>
	<article class="pm-panel">
		<div class="pm-media">
			<img class="pm-img" alt="" />
			<span class="pm-ref hidden">Foto de referencia</span>
		</div>
		<div class="pm-body">
			<h3 id="producto-modal-title" class="pm-fade text-2xl font-extrabold leading-tight text-brand-800 sm:text-3xl"></h3>
			<p class="pm-fade pm-info mt-3 leading-relaxed text-brand-900/80"></p>
			<div class="pm-fade mt-6 flex flex-wrap gap-3">
				<a
					href={`https://wa.me/${waNumber}`}
					class="producto-modal-cta inline-flex min-h-12 items-center gap-2 rounded-full bg-gold-500 px-6 font-bold text-brand-900 shadow-md transition-colors hover:bg-gold-600"
					target="_blank"
					rel="noopener noreferrer"
				>
					<WhatsAppIcon class="size-5" />
					Cotizar por WhatsApp
				</a>
				<a
					href="#solicitar-pedido"
					data-pm-form
					class="inline-flex min-h-12 items-center rounded-full border-2 border-brand-800 px-5 font-bold text-brand-800 transition-colors hover:bg-brand-800 hover:text-cream-50"
				>
					Llenar solicitud
				</a>
			</div>
		</div>
		<button type="button" class="pm-close" data-pm-close aria-label="Cerrar">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="size-5" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</article>
</dialog>

<style>
	.producto-dialog {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 1rem;
		border: 0;
		background: transparent;
		overflow: hidden;
	}
	.producto-dialog[open] {
		display: grid;
		place-items: center;
	}
	.producto-dialog::backdrop {
		background: transparent;
	}
	.pm-backdrop {
		position: absolute;
		inset: 0;
		background: rgb(0 41 95 / 0.72);
		backdrop-filter: blur(3px);
	}
	.pm-panel {
		position: relative;
		display: grid;
		width: min(100%, 58rem);
		max-height: calc(100dvh - 2rem);
		overflow: hidden;
		border-radius: 1.5rem;
		background: var(--color-cream-50);
		box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
		grid-template-rows: auto minmax(0, 1fr);
		transform-origin: 0 0;
	}
	.pm-media {
		position: relative;
		aspect-ratio: 4 / 3;
	}
	.pm-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.pm-ref {
		position: absolute;
		left: 0.75rem;
		top: 0.75rem;
		border-radius: 999px;
		background: rgb(0 41 95 / 0.75);
		padding: 0.3rem 0.75rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-cream-50);
	}
	.pm-body {
		overflow-y: auto;
		padding: 1.5rem;
	}
	.pm-close {
		position: absolute;
		right: 0.75rem;
		top: 0.75rem;
		display: flex;
		width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: rgb(0 41 95 / 0.7);
		color: var(--color-cream-50);
		backdrop-filter: blur(4px);
		transition: background-color 0.2s ease;
	}
	.pm-close:hover {
		background: var(--color-brand-900);
	}
	.pm-close:focus-visible,
	.pm-body a:focus-visible {
		outline: 3px solid var(--color-gold-500);
		outline-offset: 2px;
	}
	@media (min-width: 768px) {
		.pm-panel {
			grid-template-columns: 1.15fr 1fr;
			grid-template-rows: none;
			align-items: center;
		}
		.pm-body {
			align-self: center;
			padding: 2.5rem;
		}
	}
</style>

<script>
	import { initProductModal } from '../lib/productModal';

	initProductModal();
</script>
