---
import { WHATSAPP_URL } from '../lib/contact';
const config = {
 apiKey: import.meta.env.PUBLIC_SOLICITUDES_FIREBASE_API_KEY ?? '',
 projectId: import.meta.env.PUBLIC_SOLICITUDES_FIREBASE_PROJECT_ID ?? '',
 appId: import.meta.env.PUBLIC_SOLICITUDES_FIREBASE_APP_ID ?? '',
 siteKey: import.meta.env.PUBLIC_SOLICITUDES_RECAPTCHA_SITE_KEY ?? '',
 endpoint: import.meta.env.PUBLIC_SOLICITUDES_ENDPOINT ?? '',
};
const ready = Object.values(config).every(Boolean);
---
<section id="solicitar-pedido" class="solicitud-section bg-brand-900 py-16 text-cream-50 sm:py-24">
 <div class="solicitud-layout mx-auto max-w-6xl px-4 sm:px-8">
  <div class="solicitud-intro"><p class="text-sm font-bold uppercase tracking-widest text-gold-400">Tu celebración empieza aquí</p><h2 class="mt-4 text-3xl font-extrabold leading-tight sm:text-4xl">Cuéntanos tu pedido.<br /><span class="text-gold-400">Pongámosle sabor.</span></h2><p class="mt-5 leading-relaxed text-cream-50/80">¿Una reunión familiar, un evento o un pedido de cajas? Déjanos tu solicitud y revisaremos contigo las opciones, el precio y la disponibilidad.</p>
   <ol class="solicitud-pasos mt-8 space-y-5"><li><strong>01 · Escríbenos</strong><p>Cuéntanos con tus palabras qué necesitas: para cuántas personas, qué día o cualquier duda.</p></li><li><strong>02 · Te llamamos</strong><p>Leemos tu consulta y te contactamos al celular que nos dejes.</p></li><li><strong>03 · Confirma con nosotros</strong><p>Acordamos precio, disponibilidad y entrega antes de reservar.</p></li></ol>
   <p class="mt-8 text-sm text-cream-50/80">¿Prefieres conversar directamente? <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="font-bold text-gold-400 underline underline-offset-4">Escríbenos por WhatsApp</a>.</p>
  </div>
  <form id="solicitud-web" data-config={JSON.stringify(config)} data-ready={String(ready)} class="solicitud-form rounded-3xl bg-cream-50 p-5 text-brand-900 shadow-2xl sm:p-8">
   <h3 class="text-xl font-extrabold sm:text-2xl">Escríbenos tu consulta</h3><p class="mt-2 text-sm leading-relaxed text-brand-900/70">Solo tu nombre, tu celular y lo que necesitas. Sin pagos en esta página.</p>
   {!ready && <p class="mt-4 rounded-xl bg-gold-400/30 p-3 text-sm">Por ahora recibimos solicitudes por <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="font-bold underline">WhatsApp</a>. El envío directo estará disponible próximamente.</p>}
   <fieldset class="mt-5 space-y-4" disabled={!ready}>
    <div class="solicitud-pair"><div><label for="sol-nombre">Tu nombre</label><input id="sol-nombre" name="nombre" autocomplete="name" minlength="2" maxlength="100" required /></div><div><label for="sol-telefono">Celular o WhatsApp</label><input id="sol-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" minlength="7" maxlength="25" placeholder="Ej. 312 000 0000" required /></div></div>
    <div><label for="sol-consulta">Tu consulta</label><textarea id="sol-consulta" name="consulta" rows="6" minlength="10" maxlength="1500" required placeholder="Ej. Hola, quiero cotizar una lechona para 40 personas para el 24 de diciembre. ¿Hacen domicilio al barrio San Fernando?"></textarea><p class="sol-ayuda">Escríbelo como quieras. Nosotros te contactamos para darte el precio y la disponibilidad.</p></div>
    <div class="sol-trampa" aria-hidden="true"><label for="sol-website">Deja este campo vacío</label><input id="sol-website" name="website" tabindex="-1" autocomplete="off" /></div>
    <label class="sol-consentimiento" for="sol-consentimiento"><input id="sol-consentimiento" name="consentimiento" type="checkbox" required /><span>Autorizo el uso de mi nombre, celular y datos de la solicitud para que Chancho el Lechón me contacte y gestione esta cotización, según la <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer" class="underline">política de privacidad</a>.</span></label>
    <button type="submit" class="sol-submit inline-flex w-full items-center justify-center gap-3 rounded-full bg-gold-500 px-6 py-4 font-extrabold text-brand-900 hover:bg-gold-600"><span class="sol-spinner" aria-hidden="true"></span><svg class="sol-btn-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span class="sol-btn-texto">Enviar solicitud</span></button>
   </fieldset>
   <p id="sol-estado" role="status" aria-live="polite" tabindex="-1" class="mt-4 whitespace-pre-line text-sm leading-relaxed"></p>
   <div class="sol-exito" hidden aria-hidden="true">
    <div class="sol-exito-icono"><span class="sol-exito-onda"></span><svg viewBox="0 0 52 52"><circle class="sol-exito-circulo" cx="26" cy="26" r="24" /><path class="sol-exito-check" d="M15 27l7.5 7.5L37.5 18" /></svg></div>
    <p class="sol-exito-titulo">¡Tu solicitud fue enviada con éxito!</p>
    <p class="sol-exito-texto">Ya la recibimos. Te contactaremos pronto a tu celular para ayudarte con la cotización.</p>
    <p class="sol-exito-ref">Referencia <strong></strong></p>
    <button type="button" class="sol-exito-otra" tabindex="-1">Enviar otra solicitud</button>
    <span class="sol-exito-barra"></span>
   </div>
   <noscript><p class="mt-4 text-sm">Para solicitar sin JavaScript, <a href={WHATSAPP_URL} class="underline">escríbenos por WhatsApp</a>.</p></noscript>
  </form>
 </div>
</section>
<style>
 .solicitud-layout{display:grid;grid-template-columns:1fr 1.2fr;gap:64px;align-items:start}.solicitud-intro{position:sticky;top:36px}.solicitud-pasos p{margin-top:6px;font-size:14px;line-height:1.6;color:var(--color-brand-100)}.solicitud-pasos strong{color:var(--color-gold-500);font-size:15px}.solicitud-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}.solicitud-form{min-width:0}.solicitud-form label{display:block;font-size:13px;font-weight:700;line-height:1.5;margin-bottom:7px}.solicitud-form label span:not(.zona-opcional){font-weight:400}.solicitud-form input:not([type=checkbox]),.solicitud-form select,.solicitud-form textarea{display:block;box-sizing:border-box;min-width:0;width:100%;min-height:48px;border:1px solid var(--color-brand-200);border-radius:10px;background:white;padding:11px 12px;color:var(--color-brand-900);font-size:16px;line-height:1.5}.solicitud-form :is(input,select,textarea,button,a):focus-visible{outline:3px solid var(--color-brand-600);outline-offset:3px}.sol-ayuda{font-size:11px;line-height:1.6;margin-top:6px;color:var(--color-brand-800)}.solicitud-form .sol-consentimiento{display:flex;align-items:flex-start;gap:10px;font-size:12px;font-weight:400}.sol-consentimiento input{margin-top:3px;flex-shrink:0;width:20px;height:20px;accent-color:var(--color-brand-600)}.sol-trampa{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}fieldset:disabled{opacity:.6}.solicitud-form[aria-busy=true] fieldset:disabled{opacity:1}.solicitud-form[aria-busy=true] fieldset:disabled :is(input,textarea,label){opacity:.7}fieldset{min-width:0}.sol-submit{min-height:52px;cursor:pointer}.solicitud-form[aria-busy=true] .sol-submit{cursor:wait}.solicitud-form:focus-within{box-shadow:0 18px 50px #0003}
 .solicitud-form{position:relative;isolation:isolate}
 .sol-spinner,.sol-btn-check{display:none}
 .sol-submit{transition:background-color .35s ease,color .35s ease,transform .2s ease}
 .sol-submit.is-enviando .sol-spinner{display:block;width:18px;height:18px;border-radius:50%;border:2.5px solid currentColor;border-right-color:transparent;animation:sol-giro .7s linear infinite}
 .sol-submit.is-ok,.sol-submit.is-ok:hover{background:#15803d;color:#fff}
 .sol-submit.is-ok .sol-btn-check{display:block;width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:24;stroke-dashoffset:24;animation:sol-trazo .45s .05s ease-out forwards}
 .sol-exito{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:clamp(40px,9vh,96px) 24px 36px;text-align:center;border-radius:inherit;overflow:hidden;background:radial-gradient(120% 70% at 50% 0%,#e8f7ee 0%,#f6fbf8 45%,var(--color-cream-50) 100%)}
 .sol-exito[hidden]{display:none}
 .sol-exito-icono{position:relative;width:88px;height:88px}
 .sol-exito-icono svg{position:relative;width:100%;height:100%;fill:none;stroke-linecap:round;stroke-linejoin:round}
 .sol-exito-circulo{stroke:#15803d;stroke-width:3;fill:#15803d14;stroke-dasharray:151;stroke-dashoffset:151;transform:rotate(-90deg);transform-origin:center}
 .sol-exito-check{stroke:#15803d;stroke-width:4;stroke-dasharray:36;stroke-dashoffset:36}
 .sol-exito-onda{position:absolute;inset:0;border-radius:50%;background:#15803d;opacity:0}
 .sol-exito-titulo{margin-top:22px;font-size:clamp(20px,2.4vw,26px);font-weight:800;line-height:1.25;color:var(--color-brand-900)}
 .sol-exito-texto{margin-top:10px;max-width:340px;font-size:15px;line-height:1.6;color:var(--color-brand-800)}
 .sol-exito-ref{margin-top:16px;display:inline-flex;gap:6px;align-items:center;border-radius:999px;background:#15803d14;padding:6px 14px;font-size:12px;color:#166534}
 .sol-exito-ref strong{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}
 .sol-exito-otra{margin-top:26px;font-size:14px;font-weight:700;color:var(--color-brand-600);text-decoration:underline;text-underline-offset:4px;cursor:pointer}
 .sol-exito-barra{position:absolute;left:0;right:0;bottom:0;height:4px;background:#15803d;transform-origin:left;transform:scaleX(0)}
 .solicitud-form textarea{resize:vertical;min-height:150px}
 .sol-estado-ok{color:#166534;font-weight:700}
 @keyframes sol-giro{to{transform:rotate(360deg)}}
 @keyframes sol-trazo{to{stroke-dashoffset:0}}
 @media(prefers-reduced-motion:reduce){.sol-submit.is-enviando .sol-spinner{animation-duration:1.6s}.sol-submit.is-ok .sol-btn-check{animation:none;stroke-dashoffset:0}}
 @media(max-width:900px){.solicitud-layout{grid-template-columns:1fr;gap:32px}.solicitud-intro{position:static}.solicitud-intro>p{max-width:650px}.solicitud-pasos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.solicitud-pasos li{margin-top:0}}
 @media(max-width:540px){.solicitud-pair{grid-template-columns:1fr}.solicitud-pasos{display:block}.solicitud-pasos li+li{margin-top:16px}.solicitud-form{padding:22px 18px}.solicitud-form :is(input,select,textarea){max-width:100%}}
</style>
<script>
 import { initSolicitudWeb } from '../lib/solicitudWeb';
 const form = document.querySelector<HTMLFormElement>('#solicitud-web');
 if (form?.dataset.ready === 'true') initSolicitudWeb(form);
</script>
