---
import { WHATSAPP_URL } from '../lib/contact';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<div class="whatsapp-float-wrap fixed bottom-6 right-6 z-50">
	<!-- Botón principal -->
	<a
		href={WHATSAPP_URL}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Escríbenos por WhatsApp"
		aria-describedby="wa-tooltip"
		class="whatsapp-btn relative flex size-16 items-center justify-center rounded-full bg-brand-900 text-gold-400 shadow-2xl ring-2 ring-gold-400/40 hover:bg-brand-800 hover:ring-gold-400/70"
	>
		<!-- Halo de pulso -->
		<span class="wa-halo pointer-events-none absolute inset-0 rounded-full bg-gold-400/20" aria-hidden="true"></span>

		<!-- Icono WhatsApp -->
		<WhatsAppIcon class="wa-icon relative size-8 drop-shadow" detailed />
	</a>

	<!-- Tooltip: absolutely positioned so it reserves zero layout space and
	     never reacts to hover while hidden — only .whatsapp-btn's own
	     bounding box triggers it. -->
	<div
		class="whatsapp-tooltip pointer-events-none absolute right-full top-1/2 mr-3 select-none whitespace-nowrap rounded-xl border border-gold-400/30 bg-brand-900/95 px-4 py-2 text-sm font-semibold text-cream-50 shadow-xl backdrop-blur-sm"
		role="tooltip"
		id="wa-tooltip"
	>
		¡Escríbenos ya! 🐷
		<span class="wa-tooltip-caret absolute right-[-5px] top-1/2 size-2.5 -translate-y-1/2 rotate-45 border-r border-t border-gold-400/30 bg-brand-900/95" aria-hidden="true"></span>
	</div>
</div>

<style>
	/* Todo en CSS (sin JavaScript): entrada, halo y tooltip. Solo se animan
	   opacity/transform, que el navegador resuelve sin repintar la página. */
	.whatsapp-float-wrap {
		animation: wa-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1s both;
	}
	.whatsapp-btn {
		transition:
			background-color 0.2s ease,
			scale 0.25s ease;
	}
	.whatsapp-tooltip {
		opacity: 0;
		translate: 8px -50%;
		transition:
			opacity 0.2s ease,
			translate 0.2s ease;
	}
	@media (hover: hover) {
		.whatsapp-btn:hover {
			scale: 1.07;
		}
		.whatsapp-btn:hover + .whatsapp-tooltip {
			opacity: 1;
			translate: 0 -50%;
		}
	}
	.whatsapp-btn:focus-visible + .whatsapp-tooltip {
		opacity: 1;
		translate: 0 -50%;
	}
	.wa-halo {
		animation: wa-halo 2.4s ease-out infinite;
	}
	@keyframes wa-in {
		from {
			opacity: 0;
			transform: translateY(20px) scale(0.9);
		}
	}
	@keyframes wa-halo {
		from {
			transform: scale(1);
			opacity: 1;
		}
		to {
			transform: scale(1.55);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.whatsapp-float-wrap,
		.wa-halo {
			animation: none;
		}
	}
</style>
